rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Known admin UIDs — add yours here if role-based check fails
    // (Find your UID in Firebase Console → Authentication)
    function isKnownAdmin() {
      return request.auth.uid in [
        '2ZyN2eFQKsddGGF7wJioOI6HI4i1',  // bolaleempire@gmail.com
        'uxIVdE1lqgZRAJ5dQ4ea9WLH7282'   // michustays@gmail.com
      ];
    }

    // Role-based check (reads Firestore users doc)
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin()    { return request.auth != null && (isKnownAdmin() || getRole() == 'admin'); }
    function isManager()  { return request.auth != null && getRole() == 'manager'; }
    function isSignedIn() { return request.auth != null; }

    // ─── USERS ──────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // ─── PROPERTIES (Hotels) ─────────────────────────────────────────────
    match /properties/{propertyId} {
      allow read:   if true;
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isManager() && resource.data.managerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ─── BOOKINGS ────────────────────────────────────────────────────────
    // Only the guest who made the booking, their assigned manager, or an admin can read
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.managerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isAdmin() ||
        (isManager() && resource.data.managerId == request.auth.uid);
      allow delete: if isAdmin() || resource.data.customerId == request.auth.uid;
    }

    // ─── REVIEWS ──────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read:   if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || get(/databases/$(database)/documents/properties/$(resource.data.propertyId)).data.managerId == request.auth.uid);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ─── NOTIFICATIONS ────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (
        resource.data.targetUserId == request.auth.uid ||
        (resource.data.targetRole == 'admin' && isAdmin()) ||
        (resource.data.targetRole == 'manager' && isManager()) ||
        (resource.data.targetRole == 'customer') || // All customers can read customer alerts
        (resource.data.targetRole == 'all') ||      // Everyone can read 'all' alerts
        (!resource.data.targetUserId && !resource.data.targetRole) || // legacy global
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── CHAT THREADS ─────────────────────────────────────────────────────────
    match /chatThreads/{threadId} {
      allow read: if request.auth != null && (
        resource == null ||
        resource.data.guestId   == request.auth.uid ||
        resource.data.managerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if request.auth != null &&
        request.resource.data.guestId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.guestId   == request.auth.uid ||
        resource.data.managerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/chatThreads/$(threadId)).data.guestId   == request.auth.uid ||
          get(/databases/$(database)/documents/chatThreads/$(threadId)).data.managerId == request.auth.uid ||
          isAdmin()
        );
        allow create: if request.auth != null &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() < 2000;
        allow update: if request.auth != null && (
          (get(/databases/$(database)/documents/chatThreads/$(threadId)).data.guestId == request.auth.uid ||
           get(/databases/$(database)/documents/chatThreads/$(threadId)).data.managerId == request.auth.uid ||
           isAdmin()) &&
          (
            // Sender can edit content or delete
            (request.auth.uid == resource.data.senderId && 
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isDeleted', 'deletedAt', 'editedAt', 'hiddenForGuest', 'hiddenForManager'])) ||
            // Receiver can only update read status or hide for themselves
            (request.auth.uid != resource.data.senderId && 
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'hiddenForGuest', 'hiddenForManager'])) ||
            isAdmin()
          )
        );
        allow delete: if false;
      }
    }

    // ─── ANNOUNCEMENTS ────────────────────────────────────────────────────────
    match /announcements/{annId} {
      allow read:  if true;
      allow write: if isAdmin();
    }
  }
}
